{
  "id": "pf2e-automatic-feat-resolution",
  "title": "PF2e Automatic Feat Resolution",
  "description": "Automates the player options PF2e doesn't: class, ancestry, skill and general feats, backgrounds and the actions they grant (Teams+ content included), compiled with the character's own DCs and played by the ability module's confirmation cards.",
  "version": "0.4.0",
  "url": "https://github.com/Theholycole/pf2e-automatic-feat-resolution",
  "manifest": "https://github.com/Theholycole/pf2e-automatic-feat-resolution/releases/latest/download/module.json",
  "download": "https://github.com/Theholycole/pf2e-automatic-feat-resolution/releases/download/v0.2.1/module.zip",
  "readme": "https://github.com/Theholycole/pf2e-automatic-feat-resolution#readme",
  "bugs": "https://github.com/Theholycole/pf2e-automatic-feat-resolution/issues",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "TheHolyCole"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.5.0",
          "verified": "8.6.1"
        }
      }
    ],
    "requires": [
      {
        "id": "pf2e-resolution-core",
        "type": "module",
        "reason": "Feats are resolved by the core's families.",
        "manifest": "https://github.com/Theholycole/PF2e-Automation-Core/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.7.7"
        }
      },
      {
        "id": "pf2e-automatic-ability-resolution",
        "type": "module",
        "reason": "Feats are read by the ability module's readings and played by its cards.",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.9.7"
        }
      }
    ],
    "recommends": [
      {
        "id": "pf2e-automatic-item-resolution",
        "type": "module",
        "reason": "Stride, Step, Leap, teleport, reroll and roll-twice feats are played on the item module's cards.",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-item-resolution/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.24.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "documentTypes": {
    "RegionBehavior": {
      "senses": {}
    }
  }
}
